# darken-css.awk — the DARK THEME of style.css, generated at publish time
# (2026-09-05, user request). Reads the hand-authored assets/style.css and
# emits a `:root[data-theme="dark"]` block: every rule whose declarations
# carry a colour this program knows gets a dark twin — the SAME selectors
# prefixed with the theme root, the colours swapped by property class
# (background / text / border), every other declaration dropped. The light
# rules stay the single source of truth: a new tint added to style.css is
# dark on the next build without touching this file, as long as its colour
# is in the maps below. Rules inside @media blocks and the top bar (already
# navy) are skipped; a colour the maps do not know keeps its light value.
#
# Usage (bin/build.sh, bin/fresh.sh — after the assets copy):
#   awk -f bin/darken-css.awk assets/style.css >> docs/assets/style.css
BEGIN {
    # backgrounds (surfaces and tints)
    B["#f7f7f9"] = "#15191f"; B["#fff"] = "#1e242c"; B["#ffffff"] = "#1e242c"; B["#f2f2f2"] = "#232a33"
    B["#e8f0fe"] = "#2a3a52"; B["#dde4ec"] = "#2b3644"; B["#e4f6e4"] = "#1f3d26"; B["#fdf1dc"] = "#4a3a17"
    B["#fff3d6"] = "#4a3a17"; B["#fde3e3"] = "#4a2020"; B["#d3e6fb"] = "#1f3550"; B["#eef2f6"] = "#262e38"
    B["#f5f6f7"] = "#262b32"; B["#fafbfc"] = "#1e242c"; B["#fff6e0"] = "#3d3320"; B["#fdf0dc"] = "#4a3a17"
    B["#fdf7f7"] = "#2e2222"; B["#f6f9fc"] = "#22303c"; B["#f7f9fc"] = "#232a33"; B["#e3ebf4"] = "#2b3644"
    B["#eef1f5"] = "#2b323b"; B["#eef9ee"] = "#16211a"; B["#fdf7ea"] = "#241f14"; B["#fdeeee"] = "#241717"
    B["#e9f2fd"] = "#141c26"; B["#f1e7d8"] = "#2a2419"; B["#e2eef8"] = "#1a2530"; B["#ececec"] = "#222528"
    B["#fbf4d5"] = "#2a2716"; B["#fbe6cd"] = "#2b2118"; B["#eee2f6"] = "#241f2c"; B["#c2d7f3"] = "#2f4d75"
    B["#93b9e6"] = "#3a6499"; B["#5e93cf"] = "#4a7dbd"; B["#2c4a6b"] = "#3a5f8a"; B["#ffd36b"] = "#ffd36b"
    B["#20344a"] = "#20344a"
    # text
    C["#222"] = "#d6dbe1"; C["#444"] = "#b8c0c8"; C["#333"] = "#c4cbd3"; C["#555"] = "#a8b2bc"; C["#556"] = "#a8b2bc"
    C["#666"] = "#9aa5b1"; C["#5a6b7d"] = "#9aa5b1"; C["#66707c"] = "#9aa5b1"; C["#6b7785"] = "#9aa5b1"
    C["#5f6b78"] = "#9aa5b1"; C["#5a6673"] = "#9aa5b1"; C["#888"] = "#7f8a96"; C["#777"] = "#8a95a1"
    C["#8a94a1"] = "#7f8a96"; C["#8a94a6"] = "#7f8a96"; C["#8a97a5"] = "#7f8a96"; C["#8a97a4"] = "#7f8a96"
    C["#9aa7b4"] = "#7f8a96"; C["#94a2af"] = "#7f8a96"; C["#a9b2bc"] = "#6f7a86"; C["#b3bcc6"] = "#6f7a86"
    C["#7a8894"] = "#8a95a1"; C["#20344a"] = "#a9c4e4"; C["#33475b"] = "#b8c0c8"; C["#3b6ea5"] = "#7fb0e0"
    C["#3a5a80"] = "#7fb0e0"; C["#5b7590"] = "#8fb0d0"; C["#5a6b8c"] = "#8fb0d0"; C["#8a1c1c"] = "#ff9a9a"
    C["#7a4a00"] = "#f0c070"; C["#8a5a00"] = "#f0c070"; C["#c0392b"] = "#ff7b6b"; C["#96281b"] = "#ff9a8a"
    C["#1e7e34"] = "#6ad07f"; C["#155d27"] = "#8ae09a"; C["#566573"] = "#9aa5b1"; C["#39434e"] = "#b8c0c8"
    C["#157a48"] = "#6ad07f"; C["#2c6aa0"] = "#7fb0e0"; C["#2f7d40"] = "#6ad07f"; C["#c14638"] = "#ff7b6b"
    C["#b97c1e"] = "#f0c070"; C["#5f47a6"] = "#b9a4f0"; C["#b6bfc9"] = "#5a6470"; C["#b9c4d0"] = "#5a6470"
    # borders and outlines
    D["#ddd"] = "#3a4451"; D["#dde3ea"] = "#3a4451"; D["#e4e9ef"] = "#3a4451"; D["#cfd7de"] = "#3a4451"
    D["#ccd3db"] = "#3a4451"; D["#e8eaed"] = "#2f3842"; D["#b9c4d0"] = "#3a4451"; D["#c9d4df"] = "#3a4451"
    D["#b8d0e8"] = "#3a5f8a"; D["#20344a"] = "#6f95bd"; D["#bcdcbc"] = "#2f5a36"; D["#e8c0c0"] = "#6b2f2f"
    D["#e8d9b0"] = "#6b5320"; D["#b3cde8"] = "#2f5077"; D["#e8b0b0"] = "#6b2f2f"; D["#e8c99a"] = "#6b5320"
    D["#f0d9a0"] = "#6b5320"; D["#e6d7d7"] = "#4a3a3a"; D["#f7f7f9"] = "#15191f"; D["#c9d2dc"] = "#3a4451"
    D["#b8c2cc"] = "#3a4451"; D["#f2f2f2"] = "#232a33"; D["#e4f6e4"] = "#1f3d26"; D["#fde3e3"] = "#4a2020"
    depth = 0; buf = ""; skip = 0
    print ""
    print "/* ---- DARK THEME: generated by bin/darken-css.awk from the light rules above — do not edit here ---- */"
    print ":root[data-theme=\"dark\"] { color-scheme:dark; }"
}
function swap(decls,   n, i, d, p, v, out, k, m, lo, prop) {
    # keep only the declarations whose colour the maps know, swapped
    n = split(decls, d, ";"); out = ""
    for (i = 1; i <= n; i++) {
        p = index(d[i], ":"); if (!p) continue
        prop = d[i]; sub(/^[ \t]+/, "", prop); prop = substr(prop, 1, index(prop, ":") - 1); gsub(/[ \t]/, "", prop)
        v = substr(d[i], p + 1); lo = tolower(v)
        if (lo !~ /#[0-9a-f]+/) continue
        if (prop == "color") m = 0; else if (prop ~ /^background/) m = 1; else if (prop ~ /^(border|outline)/) m = 2; else continue
        while (match(lo, /#[0-9a-f]+/)) {
            k = substr(lo, RSTART, RLENGTH)
            if (m == 0 && (k in C)) rep = C[k]; else if (m == 1 && (k in B)) rep = B[k]; else if (m == 2 && (k in D)) rep = D[k]; else rep = ""
            if (rep == "") { lo = substr(lo, 1, RSTART - 1) "@" substr(lo, RSTART + 1); continue }   # unknown: keep, mask the hash
            lo = substr(lo, 1, RSTART - 1) "@" substr(rep, 2) substr(lo, RSTART + RLENGTH)
            hit = 1
        }
        gsub(/@/, "#", lo)
        if (hit) out = out prop ":" lo ";"
        hit = 0
    }
    return out
}
function emit(rule,   b, sel, decls, n, s, i, out, dk) {
    b = index(rule, "{"); if (!b) return
    sel = substr(rule, 1, b - 1); decls = substr(rule, b + 1); sub(/\}[ \t]*$/, "", decls)
    gsub(/\/\*[^*]*\*+([^\/*][^*]*\*+)*\//, "", sel); gsub(/^[ \t\n]+|[ \t\n]+$/, "", sel)
    if (sel == "" || sel ~ /^@/ || sel ~ /\.topbar|\.dd\b|\.dd |\.brand|envswitch|searchbtn|helpbtn|themebtn|\.csvbtn|\.colbtn|\.pickbtn/) return
    gsub(/\/\*[^*]*\*+([^\/*][^*]*\*+)*\//, "", decls)
    dk = swap(decls); if (dk == "") return
    n = split(sel, s, ","); out = ""
    for (i = 1; i <= n; i++) { gsub(/^[ \t\n]+|[ \t\n]+$/, "", s[i]); if (s[i] == "") continue; out = out (out == "" ? "" : ", ") ":root[data-theme=\"dark\"] " s[i] }
    print out " { " dk " }"
}
{ all = all $0 "\n" }
END {
    # comments OUT first — a comment may hold braces (the day pages' header
    # note quotes a whole rule), which would otherwise read as a rule and
    # open an unclosed comment in the output that swallows everything after
    while ((cs = index(all, "/*")) > 0) {
        ce = index(substr(all, cs + 2), "*/")
        if (!ce) { all = substr(all, 1, cs - 1); break }
        all = substr(all, 1, cs - 1) " " substr(all, cs + ce + 3)
    }
    # then the brace scanner over the clean text: rules may span lines;
    # @media blocks are skipped whole
    rest = all; depth = 0; buf = ""; skip = 0
    while (rest != "") {
        o = index(rest, "{"); c = index(rest, "}")
        if (!o && !c) break
        if (o && (!c || o < c)) {
            if (depth == 0) { head = substr(rest, 1, o - 1); if (head ~ /@media[^{]*$/) skip = 1 }
            buf = buf substr(rest, 1, o); rest = substr(rest, o + 1); depth++; continue
        }
        buf = buf substr(rest, 1, c); rest = substr(rest, c + 1); depth--
        if (depth <= 0) { if (!skip) emit(buf); buf = ""; skip = 0; depth = 0 }
    }
}
